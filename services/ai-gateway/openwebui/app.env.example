OPENAI_API_BASE_URL=http://cliproxyapi:8317/v1
OPENAI_API_KEY=<dedicated-openwebui-cpa-key>
WEBUI_SECRET_KEY=<random-runtime-secret>
WEBUI_AUTH=true
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=X-Auth-Request-Email
WEBUI_AUTH_TRUSTED_NAME_HEADER=X-Auth-Request-User
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=user
ENABLE_LOGIN_FORM=false
ENABLE_OLLAMA_API=false
WEBUI_URL=https://openwebui.service.lti.one
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

